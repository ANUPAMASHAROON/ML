import pandas as pd
import numpy as np
from sklearn.linear_model import LinearRegression
from sklearn.model_selection import train_test_split
from sklearn.metrics import mean_absolute_error, mean_squared_error

# Step 1: Create a small dataset (sample house data)
data = {
'Area': [1000, 1200, 1500, 1800, 2000, 2200, 2500, 3000],
'Bedrooms': [2, 2, 3, 3, 3, 4, 4, 5],
'Age': [10, 5, 8, 3, 4, 2, 1, 5],
'Price': [30, 40, 55, 65, 70, 80, 95, 110] # in Thousands
}

# Step 2: Convert to a DataFrame
df = pd.DataFrame(data)

# Step 3: Define input features (X) and output/target (y)
X = df[['Area', 'Bedrooms', 'Age']] # Features used for prediction
y = df['Price'] # Target parameter

# Step 4: Split data into training and testing
X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.2,
random_state=0)

# Step 5: Create and train the model
model = LinearRegression()
model.fit(X_train, y_train)

# Step 6: Test the model (predict prices on test data)
y_pred = model.predict(X_test)
mae = mean_absolute_error(y_test, y_pred)
mse = mean_squared_error(y_test, y_pred)
rmse = np.sqrt(mse)

# Step 7: Show the predictions
print("Predicted Prices:", y_pred)
print("Actual Prices :", list(y_test))
print("\nRegression Metrics:")
print("Mean Absolute Error (MAE) :", round(mae, 2))
print("Mean Squared Error (MSE) :", round(mse, 2))
print("Root Mean Squared Error (RMSE):", round(rmse, 2))

# Step 8: Predict price for a new house
new_house = pd.DataFrame([[2400, 4, 3]], columns=['Area', 'Bedrooms', 'Age'])
new_price = model.predict(new_house)
print("\nPredicted price for new house: ₹", round(new_price[0], 2), "Thousands")
