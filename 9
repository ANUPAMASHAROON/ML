import pandas as pd
import numpy as np
from sklearn.linear_model import LinearRegression
from sklearn.model_selection import train_test_split
from sklearn.metrics import mean_absolute_error, mean_squared_error

df = pd.DataFrame({
    'Area':[1000,1200,1500,1800,2000,2200,2500,3000],
    'Bedrooms':[2,2,3,3,3,4,4,5],
    'Age':[10,5,8,3,4,2,1,5],
    'Price':[30,40,55,65,70,80,95,110]
})

X = df[['Area','Bedrooms','Age']]
y = df['Price']

a,b,c,d = train_test_split(X,y,test_size=0.2,random_state=0)

m = LinearRegression()
m.fit(a,c)
p = m.predict(b)

mse = mean_squared_error(d,p)

print("Predicted Prices:",p)
print("Actual Prices:",list(d))
print("MAE:",round(mean_absolute_error(d,p),2))
print("MSE:",round(mse,2))
print("RMSE:",round(np.sqrt(mse),2))

new = pd.DataFrame([[2400,4,3]],columns=X.columns)
print("New House Price: ₹",round(m.predict(new)[0],2),"Thousands")
